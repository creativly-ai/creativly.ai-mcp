  "tools": [
    {
      "name": "show_assets",
      "description": "Render one to four final owned image/video results. For image-to-video workflows, pass the original images in source_images: the complete view keeps those images and the new videos together, even when the client replaces the prior card. Stored owned image inputs are also included automatically (up to four); set include_source_images=false only for an explicitly isolated result selection. Obtain completed IDs from get_job, list_assets or session results. Use meaningful titles and one approved project. Do not duplicate an unchanged image selection already shown by show_generation. Read-only: no generation or charge. Private image/poster previews, user-controlled video playback and unchanged original downloads are included. Generic clients receive the same source/result metadata and links.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "source_images": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "asset_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "asset_id"
              ],
              "additionalProperties": false
            }
          },
          "include_source_images": {
            "default": true,
            "type": "boolean"
          },
          "assets": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "asset_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "asset_id"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "project_id",
          "include_source_images",
          "assets"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "show_generation",
      "description": "Show the real progress and results of already accepted image jobs in one persistent view. Call once after generate_image or edit_image returns its batch ID; include up to four batch IDs in the same project, with at most four total image outputs. This read-only view polls get_job at its suggested interval, then retrieves completed originals with get_asset. Do not repeatedly call this render tool while work runs. It never starts, cancels or retries generation and never charges credits. For videos or clients without UI support, use the returned job data and get_job/get_asset normally.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "batch_ids": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "project_id",
          "batch_ids"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
